# ============================================================================
# Caddy + WebDAV — local media streaming for Apple TV (Infuse)
# This file is baked into the image as /etc/caddy/Caddyfile.
# Mount your own file there only when you want to replace it.
# Drop-in compatible with juvenn/caddy-dav & mholt/caddy-webdav
# ============================================================================
{
	# Required when using `webdav` outside of an explicit `route` block
	order webdav before file_server

	# Local LAN streaming — disable automatic HTTPS / ACME cert provisioning
	auto_https off

	# Match global runtime log format with access log format (`json` by default)
	log {
		format {$ACCESS_LOG_FORMAT:json}
	}

	# Performance & large video streaming tuning
	servers {
		# HTTP/1.1 + h2c on LAN for low-overhead TCP streaming
		protocols h1 h2c
		timeouts {
			# Never abort long 4K Remux streams or large WebDAV uploads
			read_body 0
			read_header 15s
			write 0
			idle 10m
		}
	}
}

# Listen on port 80 for any local hostname or IP (e.g., http://apple.local, http://media.local)
:80 {
	# Request logs are off so scrubbing a movie does not write a line per range.
	# Set ACCESS_LOG_OUTPUT=stdout (or stderr, or `file /data/access.log`) to turn them on.
	# ACCESS_LOG_FORMAT is `json` or `console`.
	log {
		output {$ACCESS_LOG_OUTPUT:discard}
		format {$ACCESS_LOG_FORMAT:json}
	}

	root * /var/media

	# Compress WebDAV PROPFIND listings so Infuse library scans move less data.
	# Video responses stay uncompressed so Linux can sendfile them.
	@propfind method PROPFIND
	encode @propfind zstd gzip

	# Remove cap on upload size when copying movies/shows to the share over WebDAV
	request_body {
		max_size 0
	}

	# Route GET and HEAD requests to `file_server` for zero-copy byte-range video streaming
	# (and browser directory listing), while passing PROPFIND/OPTIONS/PUT/DELETE/MOVE to `webdav`
	@get method GET HEAD

	route {
		file_server @get browse {
			# Browser listings only. WebDAV PROPFIND (what Infuse scans) still shows these.
			hide .DS_Store ._* Thumbs.db desktop.ini .Spotlight-V100 .Trashes
		}
		webdav
	}
}
